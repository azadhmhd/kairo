// Application-level settings for the Runner target.

// The application's name. Everything the user reads it in comes from here: the
// menu bar, the dock, the About panel, and the title of the main window, which
// the interface builder file fills in as APP_NAME.
PRODUCT_NAME = Kairo

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.kairo.desktop

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Azad Mohamed. PolyForm Noncommercial 1.0.0.
