# One ignore file for the whole repository. Packages do not carry their own.

# Dart and Flutter build output
.dart_tool/
.packages
build/
coverage/
doc/api/
*.dill

# Flutter plugin registration, regenerated by every `pub get`
.flutter-plugins
.flutter-plugins-dependencies

# The FVM-managed Flutter SDK. The version itself is pinned in .fvmrc.
.fvm/

# Written by `melos bootstrap` to point path dependencies at the local packages
pubspec_overrides.yaml

# Obfuscation and symbolication output
app.*.symbols
app.*.map.json

# Packaged DMGs. These are release assets, never repository files.
dist/

# Source footage for the README demo. The exported GIF is committed instead.
assets/*.mov

# Xcode
**/xcuserdata/
**/dgph
**/Pods/
**/Flutter/ephemeral/
*.moved-aside
*.xcuserstate

# Editors
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
.history/
*.swp

# Claude Code's per-machine settings
.claude/settings.local.json

# macOS
.DS_Store
